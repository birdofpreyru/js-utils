{
  "name": "@dr.pogodin/js-utils",
  "version": "0.2.1",
  "description": "Collection of JavaScript (TypeScript) utilities.",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    "types": "./build/index.d.ts",
    "default": "./build/index.js"
  },
  "scripts": {
    "build": "rimraf build && npm run build:logic && npm run build:types",
    "build:logic": "BABEL_ENV=production babel src -x .ts --out-dir build --source-maps",
    "build:types": "tsc --project tsconfig.types.json",
    "jest": "npm run jest:types && npm run jest:logic",
    "jest:logic": "jest --config jest.config.js --no-cache",
    "jest:types": "tstyche",
    "lint": "eslint --cache",
    "test": "npm run lint && npm run typecheck && npm run jest",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birdofpreyru/js-utils.git"
  },
  "keywords": [
    "javascript",
    "util",
    "utility"
  ],
  "author": "Dr. Sergey Pogodin <doc@pogodin.studio> (https://dr.pogodin.studio)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/birdofpreyru/js-utils/issues"
  },
  "homepage": "https://github.com/birdofpreyru/js-utils#readme",
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@dr.pogodin/eslint-configs": "^0.3.11",
    "@jest/globals": "^30.5.2",
    "@tsconfig/recommended": "^1.0.14",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "mockdate": "^3.0.5",
    "rimraf": "^6.1.4",
    "ts-jest-resolver": "^2.0.1",
    "tstyche": "^7.2.5",
    "typescript": "^6.0.3"
  },
  "type": "module"
}
